# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A TUI + headless CLI over a personal zettelkasten (SQLite)"
description:
  "A read-mostly terminal UI over a personal zettelkasten stored in SQLite, with a headless subcommand mirroring every TUI capability. Built on bonsai_term."
maintainer: ["Jones Melton <shavah@gmail.com>"]
authors: ["Jones Melton"]
license: "MIT"
homepage: "https://github.com/jonesmelton/ztk"
bug-reports: "https://github.com/jonesmelton/ztk/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2.0"}
  "async"
  "bonsai"
  "bonsai_term"
  "bonsai_term_components"
  "bonsai_term_test"
  "core"
  "core_unix"
  "ppx_jane"
  "sqlite3"
  "sqlite3_utils"
  "yojson"
  "zed"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jonesmelton/ztk.git"
